# Campus360 server settings. Set them in Vercel → Project → Settings → Environment Variables.
# None of these may be prefixed with VITE_ (that would put them in the browser bundle).

# --- Google sign-in through Firebase Authentication (Firebase Console → Project settings → Your apps → Web app) ---
# The four web-config values are public by design; the server hands them to the sign-in page at runtime.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# SECRET. 32+ random characters; signs the session cookie. Generate with:  openssl rand -base64 48
# Changing it signs everyone out.
SESSION_SECRET=

# HODs (the only way to become HOD). College Google accounts only:  hod.email@ves.ac.in=BRANCH;other@ves.ac.in=BRANCH
HOD_EMAILS=

# --- Database (Neon Postgres) ---
DATABASE_URL=

# --- Voice assistant (server-only). Add any subset; missing ones are skipped. Order: Gemini → Claude → ChatGPT. ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# AI_ORDER=gemini,claude,openai
