# Server-only. Set this in Netlify > Site settings > Environment variables.
# Never prefix it with VITE_ — that would ship it to the browser.
MINIMOTH_API_KEY=mm_test_your_key_here

# Optional: refresh-token cookie lifetime in seconds (match your MiniMoth project's refresh window; default 10 days)
MINIMOTH_REFRESH_MAX_AGE=864000

# Voice assistant (server-only — never prefix with VITE_). Add any subset; missing ones are skipped.
# Order of use (first that works answers): Gemini → Claude → ChatGPT. Change with AI_ORDER.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional overrides
# AI_ORDER=gemini,claude,openai
# GEMINI_MODEL=            (auto-picks the newest Gemini Flash model if empty)
# ANTHROPIC_MODEL=claude-haiku-5-5
# OPENAI_MODEL=gpt-5.4-mini
