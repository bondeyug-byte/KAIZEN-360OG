# Campus360 server settings. Set them in Vercel → Project → Settings → Environment Variables.
# None of these may be prefixed with VITE_ (that would put them in the browser bundle).

# --- Google sign-in through Firebase Authentication ---
# Optional overrides: the public web config defaults to the college project "kaizen-360" (api/auth.js).
# FIREBASE_PROJECT_ID=
# FIREBASE_API_KEY=            (or FIREBASE_WEB_API_KEY)
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_APP_ID=

# SECRET. Long random text (32+ characters recommended); signs the session cookie. Generate with:  openssl rand -base64 48
# Changing it signs everyone out.
SESSION_SECRET=

# --- Emailed 6-digit code after Google (second step) ---
# The Gmail account that sends the codes, and a Google "app password" for it (SECRET).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# EMAIL_OTP=off   (turns the code step off; leave unset in production)

# HODs (the only way to become HOD). College Google accounts only:  hod.email@ves.ac.in=BRANCH;other@ves.ac.in=BRANCH
# (@ves.ac.in entries in the older HOD_PHONES setting also count)
HOD_EMAILS=

# --- Database (Neon Postgres) ---
DATABASE_URL=

# --- Voice assistant (server-only). Add any subset; missing ones are skipped. Order: Gemini → Claude → ChatGPT. ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# AI_ORDER=gemini,claude,openai
